# systemd unit: starts the app at boot and restarts it if it ever dies.
[Unit]
Description=Bobcat Weight Room
After=network.target

[Service]
User=bobcat
WorkingDirectory=/opt/bobcat-weightroom
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/bobcat
Environment=BACKUP_DIR=/media/bobcat-usb/bobcat-backups
# Environment=COACH_PIN=1234
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
